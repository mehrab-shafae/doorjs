{
  "DefaultAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36 Edg/132.0.0.0",
  "killWarp": "pkill -f warp-plus",
  "rmWarpCache": "rm -rf .cache/warp-plus",
  "startWarpCmd": "bin/warp-plus --gool -b",
  "WarpTimeout": 10000,
  "WarpStartDelay": 5000,
  "KillPortDelay": 3000,
  "UnixTimeISOtz": "UTC",
  "UnixTimeISOr": "Z",
  "MAX_RETRIES": 6,
  "MAX_RETRIES_L1": 6,
  "HomePage": "https://studio.glassnode.com/home",
  "MAX_RANDOM_PORT": 65535,
  "HomePageTimeout": 130000,
  "chrome": "/usr/bin/google-chrome-stable",
  "headless": 1,
  "proxy": 1,
  "databasepSave": "/feed/",
  "databasepGet": "/feed/all_symbols/last_timestamps",
  "CRONC": "30 5 * * *",
  "CRONCtest": "*/2 * * * *",
  "UtcFormat": "YYYY-MM-DD HH:mm:ss",
  "Nodes": ["SOL", "DOGE"],
  "endpoints": [
    {
      "name": "transactions",
      "endpoint": "https://api.glassnode.com/v1/metrics/transactions/count",
      "params": {
        "i": "24h",
        "referrer": "charts"
      },
      "responseKey": "number_of_transactions"
    },
    {
      "name": "fees",
      "endpoint": "https://api.glassnode.com/v1/metrics/fees/volume_sum",
      "params": {
        "i": "24h",
        "referrer": "charts"
      },
      "responseKey": "total_fees_unit"
    }
  ]
}
